// Prisma schema для PostgreSQL (Neon)
// Документация: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Аудиты сайтов
// ============================================================
model Audit {
  id             String   @id @default(cuid())
  url            String
  overallScore   Int
  technicalScore Int
  contentScore   Int
  criticalCount  Int      @default(0)
  warningCount   Int      @default(0)
  topIssue       String?
  sitePhone      String?
  siteEmail      String?
  reportJson     Json?
  ipHash         String?
  createdAt      DateTime @default(now())

  leads          Lead[]

  @@index([url])
  @@index([createdAt])
}

// ============================================================
// Заявки с лид-формы
// ============================================================
model Lead {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  site      String?
  message   String?
  // Связь с аудитом (если заявка после аудита)
  auditId   String?
  audit     Audit?   @relation(fields: [auditId], references: [id], onDelete: SetNull)
  // Источник
  source    String   @default("website") // website | dashboard | chat
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([phone])
}

// ============================================================
// Чат-сессии (история сообщений)
// ============================================================
model ChatSession {
  id        String   @id @default(cuid())
  auditId   String?
  messages  Json     // массив {role, content, timestamp}
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([auditId])
}
